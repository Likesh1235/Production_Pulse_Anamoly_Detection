# Copy to .env.local and adjust. Never put secrets here: every VITE_* value is
# embedded into the browser bundle and visible to anyone using the dashboard.

# FastAPI backend base URL (no trailing slash)
VITE_API_BASE_URL=http://127.0.0.1:8000

# Must match [api].max_batch_size in configs/default.toml (the API does not expose it).
# The API still enforces its own limit and answers HTTP 413 if this is set too high.
VITE_MAX_BATCH_SIZE=1000

# Request timeout and status polling interval (milliseconds; 0 disables polling)
VITE_REQUEST_TIMEOUT_MS=15000
VITE_STATUS_POLL_MS=20000
